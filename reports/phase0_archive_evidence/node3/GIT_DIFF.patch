+    normalized = name.removeprefix("./")
+    path = PurePosixPath(normalized)
+    if not normalized or path.is_absolute() or ".." in path.parts:
+        return False
+    if any(
+        part.startswith("._") or part in EXCLUDED_PARTS or part == "cache"
+        for part in path.parts
